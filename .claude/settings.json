{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ruff check:*)",
      "Bash(ruff format --check:*)",
      "Bash(python -m compileall pfsense_backup.py)",
      "Bash(python3 -m compileall pfsense_backup.py)",
      "Bash(docker build:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git tag:*)",
      "Bash(docker push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./backups/**)"
    ]
  }
}
